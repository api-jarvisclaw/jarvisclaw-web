node_modules/
dist/
probe/*.png
*.log
.DS_Store

# Local wrangler state: the simulated R2 bucket that `wrangler r2 object put`
# writes to without --remote. Machine-local scratch, not shared state.
.wrangler/
probe/*.json

# The prompt-gallery media (7.9 MB of jpg/mp4). Deliberately NOT committed: R2 is where these
# actually live and are served from, and a git object is permanent even after a delete. Refetch
# with cdn/fetch-showcase.py if the upload ever has to be repeated.
cdn/showcase/

# Intermediate parser output. `parse-seedance.py` writes it and `gen-seedance-data.py` consumes it
# to produce src/lib/seedance.ts, which IS committed — so this is a duplicate of tracked content
# that would drift from it silently the moment either script changes. Regenerate, do not commit.
cdn/_seedance_rows.json
